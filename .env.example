# Optional. The app runs without this file. Copy to .env to change settings:
#   cp .env.example .env

# Leave empty for offline mode (deterministic parts work fully; AI parts use cached results).
ANTHROPIC_API_KEY=

# Change these if 3000 or 8000 are already used on your machine.
WEB_PORT=3000
API_PORT=8000

POSTGRES_PASSWORD=bidbench
LLM_MODEL_SMART=claude-sonnet-5-5
LLM_MODEL_FAST=claude-haiku-4-5-20251001
SEED_SAMPLES=true
SIM_SEED=42
LOG_LEVEL=info
